DEBUG=False
SECRET_KEY=replace-with-a-long-random-value

# Supabase/PostgreSQL. DATABASE_URL tiene prioridad sobre DB_*.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_SSLMODE=require

# Estos valores son opcionales porque Render aporta su hostname automaticamente.
ALLOWED_HOSTS=clinica-hhvc.onrender.com
CSRF_TRUSTED_ORIGINS=https://clinica-hhvc.onrender.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600

# Opcional: almacenamiento persistente de archivos subidos.
CLOUDINARY_URL=

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=recordatorio_cita
WHATSAPP_LANGUAGE_CODE=es

CLINICA_NOMBRE=Clinica Reina del Cisne
CLINICA_DIRECCION=Centro Medico Reina
EMERGENCIAS_TELEFONO=911
EMERGENCIAS_WHATSAPP=+593987654321

